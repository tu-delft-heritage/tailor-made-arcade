# Optional local image cache. Run `pnpm cache:images` before enabling these.
GAME_IMAGE_DIR=.cache/game-assets
PUBLIC_OBJECT_IMAGE_BASE=/objects

# Enables automatic fullscreen and hides the pointer for the physical cabinet.
PUBLIC_CABINET=false

# Absolute public homepage URL, including a repository path if applicable.
# GitHub Pages supplies this automatically; leave empty for local development.
# Also enables the cabinet home-screen QR code linking to this website.
# Leave unset or empty to hide the QR code; it never appears outside cabinet mode.
PUBLIC_SITE_URL=
