{
  "name": "daphnes-arcade",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "fetch:iiif": "node scripts/fetch-iiif.ts",
    "fetch:vocabularies": "node scripts/fetch-vocabularies.ts",
    "typecheck": "tsc --noEmit --project tsconfig.scripts.json",
    "test": "pnpm build:data && node --test scripts/*.test.ts",
    "data:prepare": "node scripts/prepare-game-data.ts",
    "cache:images": "node scripts/cache-images.ts",
    "build:data": "node scripts/build-game-data.ts",
    "dev": "pnpm build:data && vite dev",
    "build": "pnpm build:data && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@xstate/svelte": "^4.0.5",
    "fast-xml-parser": "^5.11.1",
    "nes.css": "^2.3.0",
    "svelte": "^5.57.0",
    "xstate": "^5.33.0"
  }
}
